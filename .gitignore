# ==============================================================================
# Git Ignore Configuration for Django Student Management System (BBU)
# ==============================================================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: NEVER commit secrets to Git!)
.env
.env.local
.env.*.local
*.env

# SQLite Database (Production uses PostgreSQL on Render/Heroku)
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Collected Static Files (generated dynamically during deployment build via collectstatic)
staticfiles/

# User Uploaded Media Files (Ignore uploaded images, keep directory structure via .gitkeep)
media/*
!media/.gitkeep
!media/profiles/
media/profiles/*
!media/profiles/.gitkeep

# Server logs and runtime outputs
*.log
server.log
server_logs/
development_plan/
lessons/
# Testing and Coverage
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.pytest_cache/

# IDEs and Code Editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build & Packaging
build/
dist/
*.egg-info/
*.egg

# Temporary & Antigravity/Agent Files
scratch/
.gemini/
